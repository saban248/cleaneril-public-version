# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DEV_MODE=true
APP_DOMAIN=localhost
PORT=5000
DATABASE_URL=sqlite:///cleaneril.db

# Business defaults (use non-personal demo values in public environments)
DEFAULT_PHONE=
DEFAULT_COMPANY_EMAIL=support@example.com

# Google OAuth / Google Ads (leave blank unless configuring the integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
INTEGRATION_REDIRECT_URI=http://localhost/integrations/{flag}/callback

# SMS provider (019)
SMS019_TOKEN=
SMS019_USERNAME=
SMS019_SOURCE_PHONE=

# Twilio (only if used by your deployment)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
